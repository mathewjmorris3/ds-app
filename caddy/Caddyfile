{$APP_HOSTNAME} {

    tls internal

    encode zstd gzip

    handle_path /static/* {
        root * /srv/static
        file_server
    }

    handle {
        reverse_proxy web:8000
    }

    header {
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
    }
}
